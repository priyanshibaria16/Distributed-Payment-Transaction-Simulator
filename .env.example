# ==============================================================================
# Environment Configuration - Distributed Payment Transaction Simulator
# ==============================================================================

# Application Environment
ENVIRONMENT=development
LOG_LEVEL=INFO

# PostgreSQL Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=payment_simulator
DB_USER=simulator_user
DB_PASSWORD=simulator_secret
DB_SSLMODE=disable

# ActiveMQ Artemis Configuration
ARTEMIS_HOST=localhost
ARTEMIS_PORT=61616
ARTEMIS_USER=artemis
ARTEMIS_PASSWORD=artemis_secret
ARTEMIS_WEB_PORT=8161

# Go API Gateway Configuration
GATEWAY_PORT=8080
JWT_SECRET=super_secret_jwt_key_payment_sim_2026_x99!
JWT_EXPIRATION_HOURS=24
JAVA_COMMAND_SERVICE_URL=http://localhost:8081
INTERNAL_API_SECRET=internal_service_secret_bridge_99x

# Java Payment Services Configuration
JAVA_COMMAND_PORT=8081
WORKER_CORE_POOL_SIZE=8
WORKER_MAX_POOL_SIZE=16
WORKER_QUEUE_CAPACITY=500
MAX_PAYMENT_RETRIES=3
SIMULATED_FAILURE_MODE=NONE
# Failure modes: NONE, RANDOM_TRANSIENT, DETERMINISTIC_FIRST_ATTEMPT, PERMANENT_FAILURE
SIMULATED_FAILURE_RATE=0.0
SIMULATED_PROCESSING_DELAY_MS=200

# Frontend Configuration
VITE_API_BASE_URL=http://localhost:8080/api/v1
